# Python bytecode and caches
__pycache__/
*.pyc
*.pyo
*$py.class
.cache_task*.pt
*.egg-info/
build/
dist/

# Compiled CUDA extensions (mgn/accel/_C*.pyd|.so).
# These are build artifacts, deliberately not tracked: regenerate with
#   python build_ext.py
# On Windows run it from a Developer Command Prompt (or after vcvars64.bat)
# so that cl.exe is on PATH.
*.pyd
*.so

# Virtual environments
venv/
env/
ENV/

# Datasets (only root /data directory)
/data/
*.tar.gz
*.gz

# Large binary checkpoints (prevent exceeding GitHub 100MB limit)
*.pth
*.pt
AML_Core_Code/*.pth
AML_Core_Code/*.pt

# Profiler traces and run logs (leak machine hostnames)
logs/
*.pt.trace.json

# Run logs
*.log
